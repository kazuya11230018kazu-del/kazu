<!DOCTYPE html>																									
<html lang="ja">																									
<head>																									
<meta charset="UTF-8">																									
<meta name="viewport" content="width=device-width, initial-scale=1.0">																									
<title>お店側 厨房・ホール管理画面</title>																									
<style>																									
body { font-family: sans-serif; margin: 0; padding: 20px; background: #2f3640; color: white; }																									
h1 { font-size: 1.4rem; border-bottom: 2px solid #718093; padding-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }																									
.refresh-info { font-size: 0.8rem; color: #ced6e0; }																									
.order-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 15px; margin-top: 20px; }																									
.order-card { background: #f5f6fa; color: #2f3640; border-radius: 8px; padding: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.3); border-left: 8px solid #ff4757; }																									
.order-card.done { border-left-color: #2ed573; opacity: 0.6; }																									
.table-tag { font-size: 1.1rem; font-weight: bold; color: #ff4757; margin-bottom: 5px; }																									
.order-time { font-size: 0.85rem; color: #57606f; margin-bottom: 10px; }																									
.order-items { font-size: 1.05rem; margin-bottom: 15px; font-weight: bold; background: white; padding: 10px; border-radius: 4px; }																									
.action-btn { width: 100%; padding: 10px; font-weight: bold; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; }																									
.btn-done { background: #2ed573; color: white; }																									
.btn-undo { background: #ffa502; color: white; }																									
																									
.receipt-box { margin-top: 30px; background: #353b48; padding: 15px; border-radius: 8px; }																									
.receipt-box input { padding: 8px; margin-right: 10px; font-size: 1rem; width: 200px; }																									
.receipt-box button { padding: 8px 15px; font-weight: bold; background: #1e90ff; color: white; border: none; border-radius: 4px; cursor: pointer; }																									
#qrDisplay { margin-top: 15px; background: white; color: black; padding: 15px; border-radius: 6px; display: none; text-align: center; }																									
</style>																									
</head>																									
<body>																									
																									
<h1>																									
<span>厨房・ホール オーダー管理</span>																									
<span class="refresh-info">（5秒ごとに自動更新）</span>																									
</h1>																									
																									
<div id="orderContainer" class="order-container">																									
<p>読み込み中...</p>																									
</div>																									
																									
<div class="receipt-box">																									
<h3>🧾 デジタル領収書（QRコード）発行</h3>																									
<div>																									
<input type="text" id="titleName" placeholder="宛名 (例: 株式会社〇〇御中)">																									
<input type="text" id="receiptTableNo" placeholder="テーブル番号" style="width: 100px;">																									
<input type="number" id="receiptAmount" placeholder="総額(税込)" style="width: 110px;">																									
<button onclick="generateReceiptQR()">領収書QR作成</button>																									
</div>																									
<div id="qrDisplay">																									
<h4 id="qrTitle"></h4>																									
<div id="qrCodeContainer" style="display: inline-block; margin-top: 10px;"></div>																									
<p style="font-size: 0.85rem; color: #666; margin-top: 5px;">お客様にこのQRコードを読み取ってもらいます</p>																									
</div>																									
</div>																									
																									
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>																									
<script>																									
const API_URL = "【ここにデプロイ後のウェブアプリURLを貼り付け】";																									
																									
window.onload = function() {																									
fetchOrders();																									
setInterval(fetchOrders, 5000);																									
};																									
																									
function fetchOrders() {																									
fetch(API_URL + "?action=getKitchenOrders")																									
.then(res => res.json())																									
.then(data => {																									
if(data.success) {																									
renderOrders(data.orders);																									
}																									
});																									
}																									
																									
function renderOrders(orders) {																									
const container = document.getElementById('orderContainer');																									
if(orders.length === 0) {																									
container.innerHTML = "<p>現在、新しい注文はありません。</p>";																									
return;																									
}																									
																									
container.innerHTML = '';																									
orders.reverse().forEach(ord => {																									
const isDone = ord.status === '提供済み';																									
container.innerHTML += `																									
<div class="order-card ${isDone ? 'done' : ''}">																									
<div class="table-tag">テーブル ${ord.tableNo} 番</div>																									
<div class="order-time">注文時刻: ${ord.timestamp} | 状態: <b>${ord.status}</b></div>																									
<div class="order-items">${ord.orderText}</div>																									
${isDone																									
? `<button class="action-btn btn-undo" onclick="updateStatus(${ord.rowIndex}, '未提供')">未提供に戻す</button>`																									
: `<button class="action-btn btn-done" onclick="updateStatus(${ord.rowIndex}, '提供済み')">提供完了にする</button>`																									
}																									
</div>																									
`;																									
});																									
}																									
																									
function updateStatus(rowIndex, status) {																									
fetch(API_URL + `?action=updateStatus&rowIndex=${rowIndex}&status=${encodeURIComponent(status)}`)																									
.then(res => res.json())																									
.then(data => {																									
if(data.success) {																									
fetchOrders();																									
} else {																									
alert("更新失敗: " + data.error);																									
}																									
});																									
}																									
																									
function generateReceiptQR() {																									
const titleName = document.getElementById('titleName').value.trim();																									
const tableNo = document.getElementById('receiptTableNo').value.trim();																									
const totalWithTax = document.getElementById('receiptAmount').value.trim();																									
																									
if(!titleName || !tableNo || !totalWithTax) {																									
alert("宛名、テーブル番号、総額をすべて入力してください");																									
return;																									
}																									
																									
const receiptData = { titleName, tableNo, totalWithTax };																									
fetch(API_URL + "?action=createReceiptQR&receiptData=" + encodeURIComponent(JSON.stringify(receiptData)))																									
.then(res => res.json())																									
.then(data => {																									
if(data.success) {																									
document.getElementById('qrDisplay').style.display = 'block';																									
document.getElementById('qrTitle').innerText = `${titleName} / ¥${Number(totalWithTax).toLocaleString()} (卓:${tableNo}番)`;																									
																									
const container = document.getElementById('qrCodeContainer');																									
container.innerHTML = '';																									
																									
const qrText = `【インボイス対応デジタル領収書】\n宛名: ${titleName}\n合計: ¥${totalWithTax} (税込)\nテーブル: ${tableNo}番\n発行済み`;																									
new QRCode(container, {																									
text: qrText,																									
width: 150,																									
height: 150																									
});																									
} else {																									
alert("領収書データ作成エラー: " + data.error);																									
}																									
});																									
}																									
</script>																									
																									
</body>																									
</html>																									
