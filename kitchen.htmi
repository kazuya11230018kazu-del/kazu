<p>注文データを読み込み中...</p>																									
</div>																									
																									
<script>																									
const GAS_API_URL = "https://script.google.com/macros/s/AKfycbz1UPfYqM3ww8ZImbqpOCM73qXw5hrrzdJG75chYd5P8V-9Z6mQdrbDo0GyxEtq4UJbNw/exec";																									
																									
async function fetchOrders() {																									
try {																									
const response = await fetch(`${GAS_API_URL}?action=getOrders`);																									
const result = await response.json();																									
if (result.status === "success") {																									
renderOrders(result.data);																									
}																									
} catch (e) {																									
console.error("ポーリングエラー:", e);																									
}																									
}																									
																									
function renderOrders(rows) {																									
const container = document.getElementById("orderContainer");																									
if (!rows || rows.length === 0) {																									
container.innerHTML = "<p>現在、新しい注文はありません。</p>";																									
return;																									
}																									
																									
let ordersMap = {};																									
rows.forEach(row => {																									
const id = row.注文ID;																									
if (!id) return;																									
if (!ordersMap[id]) {																									
ordersMap[id] = {																									
orderId: id,																									
status: row.調理ステータス || "調理待ち",																									
time: row.注文日時 ? new Date(row.注文日時).toLocaleTimeString() : "",																									
items: []																									
};																									
}																									
ordersMap[id].items.push({ name: row.商品名, qty: row.数量 });																									
});																									
																									
const orderKeys = Object.keys(ordersMap);																									
if (orderKeys.length === 0) {																									
container.innerHTML = "<p>現在、有効な注文はありません。</p>";																									
return;																									
}																									
																									
container.innerHTML = orderKeys.map(id => {																									
const order = ordersMap[id];																									
return `																									
<div class="order-card">																									
<h3>																									
<span>${order.orderId}</span>																									
<span class="status-${order.status}">${order.status}</span>																									
</h3>																									
<p style="font-size: 0.85rem; color: #666; margin: 5px 0;">時間: ${order.time}</p>																									
<ul>																									
${order.items.map(i => `<li><b>${i.name}</b> × ${i.qty}</li>`).join('')}																									
</ul>																									
<div class="btn-group">																									
<button class="btn-cooking" onclick="updateStatus('${order.orderId}', '調理中')">調理中</button>																									
<button class="btn-done" onclick="updateStatus('${order.orderId}', '提供済み')">提供済み</button>																									
</div>																									
</div>																									
`;																									
}).join('');																									
}																									
																									
async function updateStatus(orderId, status) {																									
try {																									
const response = await fetch(GAS_API_URL, {																									
method: "POST",																									
body: JSON.stringify({ action: "updateStatus", payload: { orderId: orderId, status: status } })																									
});																									
const result = await response.json();																									
if (result.status === "success") {																									
fetchOrders();																									
} else {																									
alert("更新失敗: " + result.message);																									
}																									
} catch (e) {																									
console.error(e);																									
alert("通信エラーが発生しました。");																									
}																									
}																									
																									
setInterval(fetchOrders, 4000);																									
window.onload = fetchOrders;																									
</script>																									
</body>																									
</html>																									
